# Server-only secrets. Never place these in the Pages config or commit .env.
SPRING_PROFILES_ACTIVE=github
SPORTFIT_STORAGE=github
SPORTFIT_GITHUB_REPOSITORY=retomydb/SportFit
SPORTFIT_GITHUB_BRANCH=main
SPORTFIT_GITHUB_TOKEN=
# Base64-encoded 32 random bytes. Keep a private backup; losing it loses access to stored data.
SPORTFIT_DATA_KEY=
SPORTFIT_ALLOWED_ORIGINS=https://retomydb.github.io,http://localhost:8087,http://127.0.0.1:8087

# Verified Resend sender for password-recovery emails (server only).
SPORTFIT_RESEND_API_KEY=
SPORTFIT_EMAIL_FROM=
SPORTFIT_FRONTEND_URL=https://retomydb.github.io/SportFit/
